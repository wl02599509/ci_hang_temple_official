<div class="content-header">
  <h2>上傳資料檔</h2>
  <p>請上傳 .xlsx 或 .csv 檔案,系統解析後將開啟列印預覽。</p>
</div>

<div class="form-container" style="max-width: 720px;">
  <%= form_with url: url_for(action: :preview), multipart: true, data: { turbo: false } do |form| %>
    <div class="form-group">
      <%= form.label :file, "資料檔(.xlsx / .csv)", class: "form-label" %>
      <%= form.file_field :file, accept: ".xlsx,.csv", required: true, class: "form-input" %>
    </div>

    <div class="form-actions" style="margin-top: 1.5rem;">
      <%= form.submit "產生列印預覽", class: "btn btn-primary" %>
      <%= link_to "返回列印作業", admin_print_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
